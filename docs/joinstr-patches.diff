+pub fn hash_to_point_tagged(p: &Point, tag: &[u8]) -> Point {
+    let bytes = p.serialize();
+    let len = (tag.len() as u32).to_le_bytes();
+    for i in 0u32.. {
+        let t = tagged_hash("joinstr/v2/lij/hash_to_point_tagged", &[&bytes, &len, tag, &i.to_le_bytes()]);
