# v687 (S45, DP): security headers on every response. They cannot stop a
# hostile deploy (they come from the same origin as the code) — they close
# the third-party doors: downgrade to plain HTTP, framing, foreign script,
# feature abuse. The CSP carries 'unsafe-inline' because the wallet page has
# This /* policy keeps 'unsafe-inline' for the site root and /join (one inline
# script each). The WALLET's policy is the strict one in the /wallet/* block
# below (v708, S45): script-src 'self' + a sha256 per inline block, no
# 'unsafe-inline' — every handler is an action attribute since v707.
# connect-src stays broad on purpose: the wallet talks to whichever LSP, chain
# source and registry the user chooses.
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https: wss:; worker-src 'self' blob:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'

# Cloudflare Pages response headers.
# The wasm glue + binary keep fixed filenames, so without explicit cache
# control Cloudflare's edge (and the browser) can serve a stale build even
# after a deploy — the ?v= query trick does NOT bust an edge cache that
# ignores query strings. Force revalidation so every deploy actually lands.
/pkg/*
  Cache-Control: no-cache, must-revalidate

# The wallet shell itself must always be the freshest deployed copy, otherwise
# the (correct) wasm URLs inside it never get requested.
# v708 (S45, DP "Proceed" — CSP strict-mode lift, step 3, THE FLIP): the wallet's
# ENFORCING policy. `! Content-Security-Policy` removes the /* line first
# (Cloudflare applies a block's unsets before its sets), then the strict line
# is set: script-src 'self' + the sha256 of each of the wallet page's 9 inline
# <script> blocks + 'wasm-unsafe-eval' — NO 'unsafe-inline' for script. The
# hashes are written by the cut (ops/frontend/lij_csp.py) from the final page
# bytes on every build; the cut refuses to write while any inline handler
# exists (census 0/0/0 since v707). Styles keep 'unsafe-inline' (style
# injection cannot run script; img-src/font-src 'self' block CSS beacons).
# LAW (workers-sdk constructConfiguration.ts `rules[rule.path] = ...`): ONE
# block per path — a second /wallet/* block would overwrite this one.
/wallet/*
  Cache-Control: no-cache, must-revalidate
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-VwKNflwWsPO5Ps0FXkHOx5FmUJqrjfLN2S5/NxOMzZA=' 'sha256-AK1Uoz8oCBeqnRu0PwCWF7zf/JvsilNTyw6kl/R3vII=' 'sha256-LaHm2PmAzG/nF0iSyXtHyF7/l94jI9VlshfImux7PTM=' 'sha256-1pCejtDbMVoX8Tk5rbLFDlBMXB44Av965FC8uSGq3tM=' 'sha256-6cfHuVRBq5zxHrMV1SeQr6usF19Xw6KC4L8zKxuceq4=' 'sha256-nVUSGDF5+A8cVhEyfXg0s5uWP0pCptEG0PC5eB7UQ1A=' 'sha256-Cr2cPf5p5JJYZTtG8ZF0GrZtzuNY/Y4aK/GV+h1G0P8=' 'sha256-2nN9FQMItJNd88W6IO9RjDU2YeLbgvZUSDPf7YcK620=' 'sha256-TYJG2iIPFFFqHBmMSVk0FlHqjfc9U6Zbr2u4JiyovyY=' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https: wss:; worker-src 'self' blob:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'

/index.html
  Cache-Control: no-cache, must-revalidate

# Black Start (S48): the /recover page is the words-only exit — always the freshest copy.
# S52 (DP): no-transform — the bytes served must be the bytes in the repository (the daily
# canary and the reader's own SHA-256 check of a saved copy both compare them); Cloudflare
# documents its body changes (the analytics beacon, email obfuscation, JavaScript
# detections) as off when the origin sends no-transform.
/recover/*
  Cache-Control: no-cache, must-revalidate, no-transform

# v313: the site-root stylesheet was NOT covered above — and this file’s
# own note is right that ?v= does not bust an edge that ignores query
# strings. Every stylesheet revalidates from now on.
/*.css
  Cache-Control: no-cache, must-revalidate
